# PostgreSQL backend
DATA_BACKEND=postgres
DATABASE_URL=

# Session, PIN, and request authentication
ADMIN_SESSION_SECRET=
ADMIN_REGIONAL_PIN=
LOGIN_RATE_LIMIT_SECRET=
HR_SESSION_SECRET=
HR_PIN_SALT=
LOCAL_PIN_SALT=
EMPLOYEE_VIEW_SESSION_SECRET=
CRON_SECRET=

# Public origin and feature exposure
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_ENABLE_PUBLIC_ATTENDANCE=false
PUBLIC_ATTENDANCE_ENABLED=false
# Enable only when SmartASP overwrites X-Forwarded-For/X-Real-IP for every request.
TRUST_SMARTASP_PROXY=false

# Persistent writable directory for enrollment photos
LOCAL_FILE_STORAGE_DIR=

# Optional explicit Human model URL; bundled /public/models/human is the default.
NEXT_PUBLIC_HUMAN_MODEL_URL=

# Biometric runtime settings
SERVER_ATTENDANCE_PAD_ENABLED=false
ATTENDANCE_FAST_SINGLE_FRAME_ENABLED=false
INCLUDE_OPENVINO_RUNTIME=false
OPENVINO_MODEL_DIR=
OPENVINO_SHADOW_ENABLED=false
OPENVINO_BENCHMARK_SECRET=
OPENVINO_BENCHMARK_RETURN_DESCRIPTOR=false

# Optional PostgreSQL connection-pool tuning
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=5000

# Optional local PostgreSQL control-script paths
POSTGRES_BIN_DIR=
POSTGRES_DATA_DIR=
POSTGRES_LOG_DIR=

# Optional key namespace prefixes
CACHE_KEY_PREFIX=
KV_KEY_PREFIX=
