<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" />
    </handlers>

    <httpPlatform processPath="node" arguments="app.js"
      startupTimeLimit="120" startupRetryCount="2"
      stdoutLogEnabled="true" stdoutLogFile="./logs/node">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="NEXT_PUBLIC_SITE_URL" value="https://veriface.region12.dilg.gov.ph/" />
        <environmentVariable name="LOCAL_FILE_STORAGE_DIR" value=".\App_Data\veriface-files" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
